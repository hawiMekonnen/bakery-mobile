# ==============================================================================
# BakerAdmin Enterprise Production Environment Configuration
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# Database Configuration (PostgreSQL 14+)
DATABASE_URL=postgresql://postgres:password@localhost:5432/bakeradmin_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=bakeradmin_db
PGUSER=postgres
PGPASSWORD=your_secure_db_password

# Superadmin Initial Bootstrap Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_password_minimum_12_chars

# Security & Tokens
JWT_SECRET=replace_with_64_byte_random_hex_string
DEFAULT_OFFLINE_HOURS=72

# CORS & Network Boundaries
CORS_ORIGIN=http://localhost:5000
